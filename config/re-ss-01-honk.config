# FanchmWrt-snapshot JDCloud RE-SS-01 + honk 专用配置
# 目标: qualcommax/ipq60xx/jdcloud_re-ss-01 (AX1800 Pro, IPQ6000, aarch64_cortex-a53)
# 用法: 工作流会自动 cp 到 openwrt/.config 然后 make defconfig
# 本地验证: cp config/re-ss-01-honk.config openwrt/.config && make defconfig
# 兼容 26.05 (kernel 6.12) 与 26.11 (kernel 6.18) 两条线

# ===== Target =====
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
# 只编这一个机型, 省时间省空间
CONFIG_TARGET_ALL_PROFILES=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# eMMC 机器 rootfs 给大一点, honk 核心 ~13MB + doona 面板, 默认 17MB 固件塞不下
CONFIG_TARGET_ROOTFS_PARTSIZE=300
CONFIG_TARGET_KERNEL_PARTSIZE=64

# ===== 内核 eBPF/BTF (honk 必需) =====
# honk 与 dae 同源, 运行时要 /sys/kernel/btf/vmlinux 做 CO-RE 重定位
# 注意: KERNEL_DEBUG_INFO_REDUCED 默认 y, 会卡掉 BTF (depends on !REDUCED), 必须显式关掉
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_JIT=y

# ===== 开发者选项 (必须, 否则 BPF_TOOLCHAIN 选择题 prompt 不可见,
#      Kconfig 会忽略 .config 里写的 BPF_TOOLCHAIN_HOST=y 强制回落默认值) =====
CONFIG_DEVEL=y

# ===== BPF 工具链 =====
# honk 本体是预编译核心 (包内直接下载 aarch64 tar.gz), 但 bpf-headers / vmlinux.h
# 仍要用主机 clang 生成, 走 host 工具链最稳最快; runner 已升到 24.04 (clang 18)
CONFIG_BPF_TOOLCHAIN_HOST=y

# ===== honk 主体 (kenzok8/openwrt-honk 源) =====
# honk = dae 的 Rust 重写版, eBPF 内核态分流; 核心自带 doona Web 面板
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_luci-i18n-honk-zh-cn=y

# ===== honk 运行时依赖 (Makefile DEPENDS 里已声明, 这里显式写死便于闸门校验) =====
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_sqlite3-cli=y
CONFIG_PACKAGE_usign=y
CONFIG_PACKAGE_coreutils-stat=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y

# ===== 基础体验 (保留官方默认习惯) =====
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# ===== 文件系统 / 工具 =====
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_usbutils=y
