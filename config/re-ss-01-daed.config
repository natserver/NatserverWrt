# FanchmWrt-snapshot JDCloud RE-SS-01 + daed 专用配置
# 目标: qualcommax/ipq60xx/jdcloud_re-ss-01 (AX1800 Pro, IPQ6000, aarch64_cortex-a53)
# 用法: 工作流会自动 cp 到 openwrt/.config 然后 make defconfig
# 本地验证: cp config/re-ss-01-daed.config openwrt/.config && make defconfig

# ===== Target =====
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
# 只编这一个机型, 省时间省空间
# CONFIG_TARGET_ALL_PROFILES is not set
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_ALL_PROFILES=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# eMMC 机器 rootfs 给大一点, daed 单体 ~22MB, 默认 17MB 固件塞不下
CONFIG_TARGET_ROOTFS_PARTSIZE=300
CONFIG_TARGET_KERNEL_PARTSIZE=64

# ===== 内核 eBPF/BTF (dae/daed 必需) =====
# dae Makefile 要求: KERNEL_DEBUG_INFO_BTF + KERNEL_BPF_EVENTS
# daed 要求: KERNEL_XDP_SOCKETS
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_JIT=y

# ===== BPF 工具链 (dae 编译 eBPF 必需, 否则报 /invalid/clang) =====
# OpenWrt 默认 BPF_TOOLCHAIN_BUILD_LLVM 在 defconfig 下经常落空导致
# LLVM_PATH=/invalid, 用主机 clang (工作流已 apt 安装 clang-14) 最稳最快
CONFIG_BPF_TOOLCHAIN_HOST=y

# ===== dae / daed 主体 (kenzok8/openwrt-daede 源) =====
CONFIG_PACKAGE_dae=y
CONFIG_PACKAGE_daed=y
# kenzok8 源里的 LuCI 叫 luci-app-daede (多一个 e), QiuSimons 源叫 luci-app-daed
# 两个都写上, 哪个存在哪个生效, 不存在的会被 defconfig 丢掉
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_luci-i18n-daede-zh-cn=y
CONFIG_PACKAGE_luci-i18n-daed-zh-cn=y

# BTF 兜底: 如果内核 BTF 没编进去, 用 vmlinux-btf 包
CONFIG_PACKAGE_vmlinux-btf=m

# ===== dae/daed 运行时依赖 =====
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y

# ===== 基础体验 (保留官方默认习惯) =====
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_vim-fuller=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# ===== Go 编译依赖 (dae/daed 是 Go, 自动拉起, 这里显式打开防止被裁) =====
CONFIG_PACKAGE_golang=y

# ===== 文件系统 / 工具 =====
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_usbutils=y
